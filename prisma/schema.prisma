generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  password      String?
  role          String    @default("admin")
  avatarUrl     String?
  bio           String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Page {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  content   String   // JSON string representing the components
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteSettings {
  id             String   @id @default("global")
  siteName       String   @default("My Business Site")
  siteDesc       String?
  logoUrl        String?
  primaryColor   String   @default("#6366f1")
  contactEmail   String?
  homePageId     String?  // The slug of the page to use as the home page
  globalHeader   String?  // JSON string representing the global navbar
  globalFooter   String?  // JSON string representing the global footer
  updatedAt      DateTime @updatedAt
}
